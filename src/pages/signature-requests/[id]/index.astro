---
import AppLayout from "../../../layouts/AppLayout.astro";
import { getOffer } from "@/lib/offers";
import { recipientLabel, recipientSummary } from "@/lib/offers-shared";

export const prerender = false;

const STATUS: Record<string, string> = {
  draft: "Draft",
  pending: "Sent",
  completed: "Completed",
  declined: "Declined",
  canceled: "Canceled",
  expired: "Expired",
};

const { id } = Astro.params;
let offer = null;
let loadError = "";

if (!id) {
  loadError = "Missing signature request id";
} else {
  try {
    offer = await getOffer(id);
  } catch (e) {
    loadError = e instanceof Error ? e.message : String(e);
  }
}
---

<AppLayout title={offer?.title ?? "Signature request"}>
  <div class="space-y-6">
    <p class="text-sm text-zinc-600">
      <a href="/signature-requests" class="text-zinc-700 underline hover:text-zinc-900">All signature requests</a>
    </p>

    {loadError ? (
      <p class="text-sm text-red-600">{loadError}</p>
    ) : offer ? (
      <>
        <div class="rounded-xl border border-zinc-200 bg-white p-5">
          <p class="text-xs uppercase tracking-wide text-zinc-500">Signature request</p>
          <h2 class="text-xl font-semibold">{offer.title}</h2>
          <p class="mt-2 text-sm text-zinc-600">
            Status: <strong>{STATUS[offer.status] || offer.status}</strong>
            {" · "}
            {recipientSummary(offer)}
          </p>
          <p class="mt-1 font-mono text-xs text-zinc-500">{offer.id}</p>
        </div>

        <section class="rounded-xl border border-zinc-200 bg-white p-5">
          <h3 class="text-base font-semibold">Recipients</h3>
          {offer.recipients.length === 0 ? (
            <p class="mt-2 text-sm text-zinc-500">No recipients yet.</p>
          ) : (
            <ul class="mt-3 divide-y divide-zinc-100 rounded-md border border-zinc-200">
              {offer.recipients.map((r) => (
                <li class="px-3 py-2 text-sm">{recipientLabel(r)}</li>
              ))}
            </ul>
          )}
        </section>

        {offer.status === "draft" ? (
          <div class="flex flex-wrap gap-3">
            <a
              href={`/signature-requests/${offer.id}/fields`}
              class="rounded-md border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-900 no-underline hover:bg-zinc-50"
            >
              Place fields
            </a>
            <a
              href={`/signature-requests/${offer.id}/send`}
              class="rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-zinc-800"
            >
              Send
            </a>
          </div>
        ) : (
          <a
            href={`/signature-requests/${offer.id}/send`}
            class="inline-block rounded-md border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-900 no-underline hover:bg-zinc-50"
          >
            Open signing links
          </a>
        )}
      </>
    ) : null}
  </div>
</AppLayout>
